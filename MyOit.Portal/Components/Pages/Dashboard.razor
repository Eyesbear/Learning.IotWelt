@page "/dashboard"
@inject NavigationManager Navigation
@using Microsoft.Identity.Web
@using Microsoft.Extensions.Options
@using MyOit.Portal.Models
@inject IotWeltApiClient Api
@inject IOptions<DashboardOptions> DashboardOptions
@implements IAsyncDisposable
@attribute [Authorize]

<PageTitle>Dashboard</PageTitle>

<h1>Live-Dashboard</h1>

@if (devices == null)
{
    <p>Daten werden geladen...</p>
}
else if (devices.Count == 0)
{
    <p>Keine Geräte vorhanden.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var device in devices)
        {
            var online = IsOnline(device);
            <div class="col">
                <div class="card h-100 @(online ? "" : "border-secondary text-secondary")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>@device.Name</strong>
                        <span class="badge @(online ? "bg-success" : "bg-secondary")">
                            @(online ? "Online" : "Offline")
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="row text-center g-3">
                            <div class="col-6">
                                <div class="p-3 rounded bg-light">
                                    <div class="fs-3 fw-semibold">@FormatTemp(device.Temperatur)</div>
                                    <div class="small text-muted">Temperatur</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 rounded bg-light">
                                    <div class="fs-3 fw-semibold">@FormatHumidity(device.RelativeFeuchte)</div>
                                    <div class="small text-muted">Luftfeuchte</div>
                                </div>
                            </div>
                            <div class="col-12">
                                @if (device.Wassertank == true)
                                {
                                    <div class="p-2 rounded bg-danger text-white fw-semibold">Wasseralarm aktiv</div>
                                }
                                else
                                {
                                    <div class="p-2 rounded bg-light text-muted">Wassertank OK</div>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="card-footer small text-muted d-flex justify-content-between align-items-center">
                        <span>@(device.Standort ?? device.Typ ?? "—")</span>
                        <span>@FormatTime(device.ZuletztGemeldet)</span>
                        <a href="/devices/@device.Id" class="btn btn-outline-secondary btn-sm">Verlauf</a>
                    </div>
                </div>
            </div>
        }
    </div>
    <p class="text-muted small mt-3">Aktualisierung alle 30 Sekunden — zuletzt: @lastRefresh.ToLocalTime().ToString("HH:mm:ss")</p>
}

@code {
    private List<DeviceDashboardDto>? devices;
    private DateTime lastRefresh = DateTime.UtcNow;
    private PeriodicTimer? timer;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        _ = RefreshLoop();
    }

    private async Task RefreshLoop()
    {
        while (await timer!.WaitForNextTickAsync())
        {
            await Refresh();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task Refresh()
    {
        try
        {
            devices = await Api.GetDashboardAsync();
            lastRefresh = DateTime.UtcNow;
        }
        catch (MicrosoftIdentityWebChallengeUserException)
        {
            Navigation.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("MicrosoftIdentity/Account/SignIn", forceLoad: true);
        }
    }

    private bool IsOnline(DeviceDashboardDto d)
        => d.ZuletztGemeldet.HasValue
           && (DateTime.UtcNow - d.ZuletztGemeldet.Value).TotalMinutes < DashboardOptions.Value.OfflineAfterMinutes;

    private static string FormatTemp(double? t)
        => t.HasValue ? $"{t.Value:F1} °C" : "—";

    private static string FormatHumidity(double? h)
        => h.HasValue ? $"{h.Value:F1} %" : "—";

    private static string FormatTime(DateTime? dt)
        => dt.HasValue ? dt.Value.ToLocalTime().ToString("HH:mm:ss") : "—";

    public async ValueTask DisposeAsync()
    {
        timer?.Dispose();
        await Task.CompletedTask;
    }
}
