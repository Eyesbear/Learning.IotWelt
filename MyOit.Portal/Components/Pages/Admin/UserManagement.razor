@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@rendermode @(new InteractiveServerRenderMode(prerender: false))

@inject IotWeltApiClient Api
@inject IJSRuntime JS
@using IotWelt.Common

<PageTitle>Benutzerverwaltung</PageTitle>

<h2 class="mb-4">Benutzerverwaltung</h2>

<div class="alert alert-info mb-3">
    Vorerst nur die Kundenkonten: Die Verwaltung der Logins (Admin-Rolle, Logins löschen,
    Mitglieder) folgt mit dem nächsten Ausbauschritt (PR 1e).
</div>

@if (errorMessage is not null)
{
    <div class="alert alert-danger mb-3">@errorMessage</div>
}

@if (isLoading)
{
    <p>Wird geladen…</p>
}
else if (customerRows.Count == 0)
{
    <p>Keine Kundenkonten vorhanden.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Eigentümer</th>
                    <th>E-Mail</th>
                    <th>Kunden-ID</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in customerRows)
                {
                    <tr>
                        <td>@(row.Profile.DisplayName ?? "—")</td>
                        <td>@(row.Profile.Email ?? "—")</td>
                        <td><code>@row.Profile.CustomerId</code></td>
                        <td>
                            <button class="btn btn-sm btn-outline-danger"
                                    disabled="@row.IsBusy"
                                    @onclick="@(() => DeleteCustomerAsync(row))">
                                Löschen
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private class CustomerRow
    {
        public CustomerProfileDto Profile { get; init; } = null!;
        public bool IsBusy { get; set; }
    }

    // Eine Zeile pro Konto — ein Eigentümer mit mehreren Konten erscheint mehrfach
    private List<CustomerRow> customerRows = [];
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var profiles = await Api.GetAdminCustomersAsync();
            customerRows = profiles.Select(p => new CustomerRow { Profile = p }).ToList();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // Die API löscht ALLE Konten dieses Eigentümers samt Geräten und Messdaten,
    // der Login selbst bleibt bestehen.
    private async Task DeleteCustomerAsync(CustomerRow row)
    {
        var ownerId = row.Profile.OwnerId;
        var accountCount = customerRows.Count(r => r.Profile.OwnerId == ownerId);
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"Alle Konten von \"{row.Profile.DisplayName ?? row.Profile.Email}\" ({accountCount}) mit allen Geräten und Messdaten löschen?\n" +
            "Der Login selbst bleibt bestehen.\nDiese Aktion kann nicht rückgängig gemacht werden.");
        if (!ok) return;

        row.IsBusy = true;
        errorMessage = null;
        try
        {
            await Api.AdminDeleteCustomerAsync(ownerId);
            customerRows.RemoveAll(r => r.Profile.OwnerId == ownerId);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            row.IsBusy = false;
        }
    }
}
