@page "/account/reset-password"
@attribute [ExcludeFromInteractiveRouting]

@using System.ComponentModel.DataAnnotations
@using IotWelt.Common.Auth
@using MyOit.Portal.Services.Auth
@inject AuthApiClient AuthApi
@inject ILogger<ResetPassword> Logger

@* Ziel des Links aus der Mail (die API baut ihn mit email und code). Beide stehen in der Query und
   bleiben beim Absenden erhalten, weil das Formular an die aktuelle URL geschickt wird. *@

<PageTitle>Passwort zurücksetzen</PageTitle>

<div class="row">
    <div class="col-md-6 col-lg-4">
        <h2 class="mb-4">Passwort zurücksetzen</h2>

        @if (string.IsNullOrEmpty(Email) || string.IsNullOrEmpty(Code))
        {
            <div class="alert alert-danger">
                Der Link ist ungültig. Bitte öffnen Sie den vollständigen Link aus der E-Mail
                oder <a href="account/forgot-password">fordern Sie einen neuen an</a>.
            </div>
        }
        else if (done)
        {
            <div class="alert alert-success">
                Ihr Passwort wurde geändert. Aus Sicherheitsgründen sind Sie jetzt auf allen Geräten abgemeldet.
            </div>
            <a href="account/login" class="btn btn-primary">Anmelden</a>
        }
        else
        {
            @if (errors is not null)
            {
                <div class="alert alert-danger">
                    @foreach (var error in errors)
                    {
                        <div>@error</div>
                    }
                    <div class="mt-2">Link abgelaufen? <a href="account/forgot-password">Neuen Link anfordern</a></div>
                </div>
            }

            <EditForm Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label for="email" class="form-label">E-Mail</label>
                    <input id="email" value="@Email" class="form-control" autocomplete="username" readonly />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Neues Passwort</label>
                    <InputText id="password" type="password" @bind-Value="Input.Password" class="form-control" autocomplete="new-password" />
                    @* Spiegelt die Identity-Optionen der API (IotWelt.API/Program.cs) *@
                    <div class="form-text">Mindestens 8 Zeichen, mit Groß- und Kleinbuchstaben und einer Ziffer.</div>
                    <ValidationMessage For="() => Input.Password" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label for="confirmPassword" class="form-label">Neues Passwort wiederholen</label>
                    <InputText id="confirmPassword" type="password" @bind-Value="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small" />
                </div>

                <button type="submit" class="btn btn-primary w-100">Passwort ändern</button>
            </EditForm>
        }
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromForm]
    private ResetPasswordInput Input { get; set; } = default!;

    private IReadOnlyList<string>? errors;
    private bool done;

    // Beim POST setzt das Formular-Binding Input; beim ersten Aufruf (GET) gibt es noch keins
    protected override void OnInitialized() => Input ??= new();

    private async Task ResetAsync()
    {
        AuthResult result;
        try
        {
            // Code unverändert weiterreichen — die API dekodiert ihn selbst (Base64Url)
            var request = new ResetPasswordRequest(Email!, Code!, Input.Password);
            result = await AuthApi.ResetPasswordAsync(request, HttpContext.RequestAborted);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Passwort zurücksetzen: API nicht erreichbar");
            errors = ["Das ist gerade nicht möglich. Bitte versuchen Sie es später erneut."];
            return;
        }

        if (!result.Succeeded)
        {
            // Leere 400 = unbekannte Adresse; sonst Identity-Fehler (InvalidToken oder Passwortregeln)
            errors = result.Errors is { Count: > 0 } ? result.Errors : ["Der Link ist ungültig oder abgelaufen."];
            return;
        }

        done = true;
    }

    private sealed class ResetPasswordInput
    {
        [Required(ErrorMessage = "Bitte ein neues Passwort angeben.")]
        public string Password { get; set; } = "";

        [Required(ErrorMessage = "Bitte das Passwort wiederholen.")]
        [Compare(nameof(Password), ErrorMessage = "Die Passwörter stimmen nicht überein.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
