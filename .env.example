# Vorlage für .env (Staging mit Docker Compose). Kopieren: Copy-Item .env.example .env
# .env ist gitignored und gehört NIE ins Repo. Werte ohne Anführungszeichen, ohne ; und ohne $.

# SQL Server: mind. 8 Zeichen, drei von vier Gruppen (Groß, Klein, Ziffer, Sonderzeichen)
MSSQL_SA_PASSWORD=

# JWT-Signierschlüssel, Base64, mind. 32 Bytes. Erzeugen (Windows PowerShell 5.1):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SIGNING_KEY=

# Adresse, unter der das Portal im LAN erreichbar ist (für Links in Mails), z. B. http://192.168.178.20:5081
PORTAL_PUBLIC_URL=

# Optional: erster System-Admin, wird beim API-Start angelegt
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
